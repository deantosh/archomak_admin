NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional role allow-list from existing Supabase user metadata or app metadata.
SUPABASE_ALLOWED_ADMIN_ROLES=admin,administrator,staff,owner,super_admin,operations

# Existing table-based access check.
# Defaults already match the `organization_members` schema if left unchanged.
SUPABASE_ACCESS_TABLE=organization_members
SUPABASE_ACCESS_USER_ID_COLUMN=user_id
# Leave blank for organization_members, which does not have an email column.
SUPABASE_ACCESS_EMAIL_COLUMN=
SUPABASE_ACCESS_ACTIVE_COLUMN=status
SUPABASE_ACCESS_ACTIVE_VALUE=active
SUPABASE_ACCESS_ROLE_COLUMN=role
