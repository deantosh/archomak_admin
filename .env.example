NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional role allow-list from existing Supabase user metadata or app metadata.
SUPABASE_ALLOWED_ADMIN_ROLES=admin,administrator,staff,owner,super_admin,operations

# Optional existing table-based access check.
# Point these values at your current staff or admin access table instead of creating new tables.
SUPABASE_ACCESS_TABLE=
SUPABASE_ACCESS_USER_ID_COLUMN=user_id
SUPABASE_ACCESS_EMAIL_COLUMN=email
SUPABASE_ACCESS_ACTIVE_COLUMN=
SUPABASE_ACCESS_ROLE_COLUMN=
